<?xml version="1.0"?>

<robot name="dressing_table001">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="drawer_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/drawer_left_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/drawer_left_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="drawer_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/drawer_right_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/drawer_right_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="control_button_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/control_button_1_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/control_button_1_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="control_button_2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/control_button_2_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/control_button_2_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="control_button_3_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/control_button_3_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/control_button_3_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_drawer_slide" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_left_link"/>
    <origin xyz="-0.44 -0.495 0.645" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.38" effort="20" velocity="0.5"/>
  </joint>

  <joint name="right_drawer_slide" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_right_link"/>
    <origin xyz="0.44 -0.495 0.645" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.38" effort="20" velocity="0.5"/>
  </joint>

  <joint name="control_button_1_press" type="prismatic">
    <parent link="base_link"/>
    <child link="control_button_1_link"/>
    <origin xyz="-0.125 -0.092 0.906" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.012" effort="2" velocity="0.05"/>
  </joint>

  <joint name="control_button_2_press" type="prismatic">
    <parent link="base_link"/>
    <child link="control_button_2_link"/>
    <origin xyz="-0.08 -0.092 0.906" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.012" effort="2" velocity="0.05"/>
  </joint>

  <joint name="control_button_3_press" type="prismatic">
    <parent link="base_link"/>
    <child link="control_button_3_link"/>
    <origin xyz="-0.035 -0.092 0.906" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.012" effort="2" velocity="0.05"/>
  </joint>

</robot>
