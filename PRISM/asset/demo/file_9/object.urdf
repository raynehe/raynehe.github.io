<?xml version="1.0"?>
<robot name="file_9">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.obj" scale="1 1 1"/>
      </geometry>
      <material name="body_blue_grey">
        <color rgba="0.479999989 0.569999993 0.620000005 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.20" ixy="0" ixz="0" iyy="0.40" iyz="0" izz="0.55"/>
    </inertial>
  </link>

  <link name="top_panel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/top_panel_link.obj" scale="1 1 1"/>
      </geometry>
      <material name="top_panel_blue_grey">
        <color rgba="0.479999989 0.569999993 0.620000005 1"/>
