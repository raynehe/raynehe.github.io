    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/top_panel_link.obj" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.75 -0.02" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.09" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="0.28"/>
