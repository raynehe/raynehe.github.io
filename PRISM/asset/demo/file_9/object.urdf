  <joint name="top_panel_hinge_joint" type="revolute">
    <parent link="base_link"/>
    <child link="top_panel_link"/>
    <origin xyz="0 -0.769999981 0.397499979" rpy="0 -0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.22173048" effort="5" velocity="1"/>
